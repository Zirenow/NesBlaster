; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NesBlaster_v1_1"
config/description="Simple corruptor for various ROMs"
config/version="1.1"
run/main_scene="res://Master.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/image="res://prog_logo.png"
config/icon="res://prog_logo.png"
boot_splash/minimum_display_time=10

[display]

window/size/viewport_width=480
window/size/viewport_height=600
window/size/resizable=false

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true
